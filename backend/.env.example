APP_NAME=Linen House API
APP_VERSION=1.0.0
APP_DESCRIPTION=API backend para Linen House
APP_ENV=development

API_PREFIX=/api/v1
DEBUG=true

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=linen_house


# Autenticacion google
GOOGLE_CLIENT_ID=


# JWT

SESSION_SECRET_KEY=change-me-with-a-long-random-secret
SESSION_EXPIRE_MINUTES=10080
SESSION_COOKIE_NAME=linen_house_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
# Déjalo vacío para conservar la cookie limitada al host de la API.
SESSION_COOKIE_DOMAIN=
ORDER_RESERVATION_MINUTES=30
ORDER_RESERVATION_SWEEP_SECONDS=60
TEST_ORDER_MODE_ENABLED=true
PAYMENT_GATEWAY_ENABLED=false
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60

STOREFRONT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1
